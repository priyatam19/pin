graph PainPointsRadar {
    layout=circo;
    overlap=false;
    splines=true;

    graph [
        fontname="Futura",
        bgcolor="#fcfbff",
        label="Problem Landscape: Fragmented C Inputs",
        labelloc="t",
        fontsize=22,
        pad=0.8
    ];

    node [
        fontname="Futura",
        style="filled",
        fixedsize=true,
        width=2.4,
        height=2.4,
        shape=circle,
        color="#5e60ce",
        fontcolor="#ffffff"
    ];

    center [
        label="Fragmented\nC Inputs",
        shape=doublecircle,
        width=2.6,
        height=2.6,
        fillcolor="#6930c3",
        fontname="Futura Bold",
        fontsize=18
    ];

    input_format [label="Input Format\nDiversity", fillcolor="#7400b8"];
    harness [label="Manual Test\nHarnesses", fillcolor="#5a189a"];
    automation [label="Limited\nAutomation", fillcolor="#3c096c"];
    integration [label="Analysis\nIntegration Gaps", fillcolor="#4361ee"];
    scalability [label="Scalability\nLimits", fillcolor="#4895ef"];

    center -- input_format [penwidth=3, color="#9d4edd"];
    center -- harness [penwidth=3, color="#7b2cbf"];
    center -- automation [penwidth=3, color="#5a189a"];
    center -- integration [penwidth=3, color="#4cc9f0"];
    center -- scalability [penwidth=3, color="#80ffdb"];

    edge [fontname="Futura", fontsize=12, color="#adb5bd"];
    input_format -- harness [style=dashed, label="Specialized\nscripts", fontcolor="#6c757d"];
    harness -- automation [style=dotted, label="Human error", fontcolor="#6c757d"];
    automation -- integration [style=dashed, label="Incompatible\ndata models", fontcolor="#6c757d"];
    integration -- scalability [style=dotted, label="Tool fatigue", fontcolor="#6c757d"];
    scalability -- input_format [style=dashed, label="Niche protocols", fontcolor="#6c757d"];
}
